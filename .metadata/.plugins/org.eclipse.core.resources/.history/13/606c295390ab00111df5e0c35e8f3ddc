package com.merkit.service.impl;

import java.io.IOException;
import java.util.Map;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import com.cloudinary.Cloudinary;
import com.cloudinary.utils.ObjectUtils;

@Service
public class CloudinaryServiceImpl {

	private final Cloudinary cloudinary;

	public CloudinaryServiceImpl(@Value("${cloudinary.cloud-name}") String cloudName,
			@Value("${cloudinary.api-key}") String apiKey, @Value("${cloudinary.api-secret}") String apiSecret) {

		this.cloudinary = new Cloudinary(
				ObjectUtils.asMap("cloud_name", cloudName, "api_key", apiKey, "api_secret", apiSecret));
	}

	public String[] uploadImage(  MultipartFile image,  String folder) throws IOException {
]
        Map<?, ?> result = cloudinary.uploader().upload(
        		image.getBytes(),
                ObjectUtils.asMap( "folder", folder)
        );
        
        return new String[] {result.get("public_id").toString(),  result.get("secure_url").toString()};
        
    }

	public void deleteImage(String publicId) throws IOException {

		cloudinary.uploader().destroy(publicId, ObjectUtils.emptyMap());
	}
}