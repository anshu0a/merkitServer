package com.merkit.service.impl;

import java.io.IOException;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.util.List;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.userdetails.UsernameNotFoundException;
import org.springframework.stereotype.Service;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ArrayNode;
import com.fasterxml.jackson.databind.node.ObjectNode;
import com.merkit.dto.req.AIRequest;
import com.merkit.dto.res.AIChatList;
import com.merkit.dto.res.ApiResponse;
import com.merkit.entity.AIChat;
import com.merkit.entity.AIMessage;
import com.merkit.entity.User;
import com.merkit.repo.AIChatRepository;
import com.merkit.repo.UserRepository;
import com.merkit.service.AIChatService;

import jakarta.transaction.Transactional;
import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class AIChatServiceImpl implements AIChatService {

	@Value("${grok-api-key}")
	private String apiKey;

	private final UserRepository userRepository;
	private final AIChatRepository aiChatRepository;

	@Override
	public AIChat getChat(Authentication auth, Long chatId) {

		String username = auth.getName();
		User user = userRepository.findByUsername(username)
				.orElseThrow(() -> new UsernameNotFoundException("User not found with username: " + username));
		AIChat chat = aiChatRepository.findByIdAndUser(chatId, user)
				.orElseThrow(() -> new RuntimeException("AI chat not found with Id: " + chatId));

		return chat;
	}

	@Override
	@Transactional
	public AIChat addNewChat(AIRequest req, Authentication auth) {

		String username = auth.getName();
		User user = userRepository.findByUsername(username)
				.orElseThrow(() -> new UsernameNotFoundException("User not found with username: " + username));

		String question = req.getPrompt();
		String answer = getAnswer(question);
		String topic = getAnswer(
				"'" + question + "' -> give one short topic name for this question. Return only the topic name.");

		AIChat chat = AIChat.builder().chatName(topic).user(user).build();

		AIMessage msg = new AIMessage();
		msg.setQuestion(question);
		msg.setAnswer(answer);
		msg.setChat(chat);

		chat.getMessages().add(msg);

		return aiChatRepository.save(chat);
	}

	@Override
	@Transactional
	public AIMessage addOldChat(AIRequest req, Authentication auth, Long chatId) {
		String username = auth.getName();
		User user = userRepository.findByUsername(username)
				.orElseThrow(() -> new UsernameNotFoundException("User not found with username: " + username));
		AIChat chat = aiChatRepository.findByIdAndUser(chatId, user)
				.orElseThrow(() -> new RuntimeException("AI chat not found with Id: " + chatId));

		String question = req.getPrompt();
		String answer = getAnswer(question);
		
		AIMessage msg = new AIMessage();
		msg.setQuestion(question);
		msg.setAnswer(answer);
		msg.setChat(chat);

		chat.getMessages().add(msg);
		 aiChatRepository.save(chat);

		return msg;
	}
	

	@Override
	public ApiResponse saveChat(Authentication auth, Long chatId, Boolean sv) {

		String username = auth.getName();
		User user = userRepository.findByUsername(username)
				.orElseThrow(() -> new UsernameNotFoundException("User not found with username: " + username));
		AIChat chat = aiChatRepository.findByIdAndUser(chatId, user)
				.orElseThrow(() -> new RuntimeException("AI chat not found with Id: " + chatId));
		
		chat.setSaved(sv);
		aiChatRepository.save(chat);

		return ApiResponse.builder()
				.statusCode(200)
				.success(true)
				.message("Chat saved successfully.")
				.build();
	}
	
	@Override
	public List<AIChatList> getAllChat(Authentication auth) {
		String username = auth.getName();
		User user = userRepository.findByUsername(username)
				.orElseThrow(() -> new UsernameNotFoundException("User not found with username: " + username));
		List<AIChat> chat = aiChatRepository.findByUser(user).orElseThrow(() -> new RuntimeException("Chat List not found for user: "
				+ user.getUsername()));
		return null;
	}
	
	
//---------------------------------[ private methods ]------------------------------------------------------
	
	private String getAnswer(String prompt) {
		String answer = null;
		try {

			String url = "https://api.groq.com/openai/v1/chat/completions";
			ObjectMapper mapper = new ObjectMapper();
			ObjectNode root = mapper.createObjectNode();
			root.put("model", "llama-3.1-8b-instant");
			ArrayNode messages = mapper.createArrayNode();
			ObjectNode userMessage = mapper.createObjectNode();

			userMessage.put("role", "user");
			userMessage.put("content", prompt);

			messages.add(userMessage);
			root.set("messages", messages);
			String body = mapper.writeValueAsString(root);
			HttpClient client = HttpClient.newHttpClient();
			HttpRequest request = HttpRequest.newBuilder().uri(URI.create(url))
					.header("Content-Type", "application/json").header("Authorization", "Bearer " + apiKey)
					.POST(HttpRequest.BodyPublishers.ofString(body)).build();

			HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
			System.out.println(response.body());
			JsonNode json = mapper.readTree(response.body());

			answer = json.path("choices").path(0).path("message").path("content").asText();

		} catch (IOException | InterruptedException e) {
			throw new RuntimeException(e.getMessage());
		}

		if (answer == null || answer.isBlank())
			throw new RuntimeException("AI did not return answer");
		return answer;
	}



}
