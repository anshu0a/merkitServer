package com.merkit.service.impl;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageImpl;
import org.springframework.data.domain.Pageable;
import org.springframework.stereotype.Service;

import com.an.entity.Chat_Messages;
import com.an.repository.MessageRepository;

@Service
public class AIMessageServiceImpl implements AIMessageService {
	@Autowired
	private MessageRepository repo;

	@Override
	public Chat_Messages addMessage(Chat_Messages msg) {
		return repo.save(msg);
	}

	@Override
	public Page<Chat_Messages> getAllMessage(Pageable pageable) {
		Page<Chat_Messages> page = repo.findAll(pageable);
		List<Chat_Messages> list = page.getContent();
		return new PageImpl<Chat_Messages>(list, pageable, repo.count());
	}

}
